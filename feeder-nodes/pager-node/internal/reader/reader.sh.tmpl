#!/usr/bin/env bash
set -euo pipefail
# Auto gain: no -g flag => rtl_fm uses the tuner's automatic gain (hardware AGC).
# -p is the sample-clock (ppm) correction the agent measured for THIS dongle with
# rtl_test -p at startup (0 = none).
rtl_fm -d '{{.Serial}}' -f {{.FreqMHz}}M -M fm -s 22050 -p {{.PPM}} - \
 | multimon-ng {{.ProtoArgs}} -t raw /dev/stdin \
 | while IFS= read -r line; do
     curl -s --max-time 5 '{{.RelayURL}}' \
       --data-binary "$line" \
       -H 'X-Pager-Source: {{.Label}}' \
       -H "X-Pager-Freq: {{.FreqMHz}}" >/dev/null || true
   done
