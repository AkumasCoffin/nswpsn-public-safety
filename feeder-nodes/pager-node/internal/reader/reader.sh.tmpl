#!/usr/bin/env bash
set -euo pipefail
# Flags mirror the operator's proven Pagermon reader:
#   rtl_fm: -g fixed gain, -p per-dongle ppm (measured at startup; 0 if unmeasured),
#           -E dc (remove DC spike), -F 0 (enable the FIR downsample filter),
#           -l 0 (no squelch), -A fast (fast arctan demod). -d addresses the dongle
#           by its (assigned) USB serial; -f is the rtl_fm FREQUENCY.
#   multimon-ng: -b1 (1-bit BCH error correction), -c (drop empty), -f alpha
#           (alphanumeric output), -t raw /dev/stdin.
rtl_fm -d '{{.Serial}}' -g {{.Gain}} -p {{.PPM}} -E dc -F 0 -l 0 -A fast -f {{.FreqMHz}}M -s 22050 - \
 | multimon-ng -b1 -c {{.ProtoArgs}} -f alpha -t raw /dev/stdin \
 | while IFS= read -r line; do
     curl -s --max-time 5 '{{.RelayURL}}' \
       --data-binary "$line" \
       -H 'X-Pager-Source: {{.Label}}' \
       -H "X-Pager-Freq: {{.FreqMHz}}" >/dev/null || true
   done
