# Auto detect text files and perform LF normalization
* text=auto
*.wasm binary

# The API docs viewer (Scalar) is vendored byte-for-byte; its .br twin is
# compressed from these exact bytes, so git must never rewrite line endings.
backends/node/assets/scalar/** -text

# Generated by `npm run openapi` with LF endings, and a test compares it byte for
# byte with a fresh generation — a CRLF checkout would fail that test.
backends/node/openapi.json text eol=lf
