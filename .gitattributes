# Auto detect text files and perform LF normalization
* text=auto
*.wasm binary

# The API reference viewer (Scalar) is vendored byte-for-byte and its README
# records the file's sha256, so git must never rewrite its line endings.
vendor/scalar/** -text

# Generated by `npm run openapi` with LF endings, and a test compares it byte for
# byte with a fresh generation — a CRLF checkout would fail that test.
backends/node/openapi.json text eol=lf
